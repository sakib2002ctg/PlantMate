#pragma once

// Copy this file to plantmate_secrets.h. The copied file is Git-ignored.
// Never commit Wi-Fi credentials or the device ingestion key.

#define WIFI_SSID "replace-with-your-wifi-ssid"
#define WIFI_PASSWORD "replace-with-your-wifi-password"
#define DEVICE_INGESTION_KEY "copy-DEVICE_INGESTION_KEY-from-the-root-.env"
#define DEVICE_ID "esp32-greenhouse-1"

// Local laptop example:
// http://192.168.1.25:8000/api/v1/ingestion/readings
// Replace the IP with the laptop's Wi-Fi IPv4 address. For a hosted API use
// https://... and configure the correct server root CA below.
#define API_URL "http://192.168.1.25:8000/api/v1/ingestion/readings"

// Soil moisture calibration: record raw ADC values with the probe dry and in
// the target soil at the moisture level you define as 100%. Typical capacitive
// probes may read lower ADC values when wet; use raw readings from YOUR unit.
#define SOIL_DRY_ADC_RAW 0
#define SOIL_WET_ADC_RAW 0

// LDR two-point calibration: record a dark raw ADC value, then a raw value
// under a measured bright condition and its matching reference lux.
#define LIGHT_DARK_ADC_RAW 0
#define LIGHT_BRIGHT_ADC_RAW 0
#define LIGHT_BRIGHT_LUX 0.0f

// TDS calibration. The polynomial in the sketch follows DFRobot Gravity SEN0244
// example code. Confirm your module uses this transfer curve; calibrate the
// factor using a known TDS solution. Its example factor is 0.5. Set the solution
// temperature from a thermometer; the DHT22 measures ambient air.
#define TDS_CALIBRATION_FACTOR 0.5f
#define TDS_REFERENCE_TEMPERATURE_C 25.0f

// For HTTPS, replace nullptr with the server's trusted root CA PEM string.
// Local HTTP does not use this certificate. Never use setInsecure().
static const char *ROOT_CA_CERT = nullptr;
