# Local PostgreSQL used by Docker Compose
POSTGRES_DB=plantmate
POSTGRES_USER=plantmate
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5433

# Backend
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://plantmate:replace-with-a-local-password@localhost:5433/plantmate
# Keep the DATABASE_URL username/password synchronized with POSTGRES_USER/POSTGRES_PASSWORD.
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Shared only with the ESP32. Send it in the X-Device-Key request header.
DEVICE_INGESTION_KEY=replace-with-a-long-random-device-key

# Gemini AI adviser (backend only; never add either value to frontend variables)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
